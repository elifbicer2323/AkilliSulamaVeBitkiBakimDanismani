@model AkilliSulama.Web.Models.GirisModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-3">Giriş Yap</h2>

        @if (TempData["Bilgi"] is string bilgi)
        {
            <div class="alert alert-success">@bilgi</div>
        }

        <form asp-action="Giris" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Eposta" class="form-label">E-posta</label>
                <input asp-for="Eposta" class="form-control" />
                <span asp-validation-for="Eposta" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Sifre" class="form-label">Parola</label>
                <input asp-for="Sifre" class="form-control" />
                <span asp-validation-for="Sifre" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">Giriş Yap</button>
        </form>

        <p class="mt-3">Hesabın yok mu? <a asp-action="Kayit">Kayıt ol</a></p>
    </div>
</div>